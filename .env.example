# Copy to .env and adjust. Never commit .env.

# Master key used to encrypt provider API keys at rest.
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AGENTOFFICE_SECRET_KEY=change-me

AGENTOFFICE_DATABASE_URL=postgresql+asyncpg://agentoffice:agentoffice@localhost:5432/agentoffice
AGENTOFFICE_REDIS_URL=redis://localhost:6379/0
AGENTOFFICE_CORS_ORIGINS=["http://localhost:5173"]
