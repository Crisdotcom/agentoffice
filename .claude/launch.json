{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd backend && PYTHONPATH=packages/llm_gateway/src uv run uvicorn app.main:app --port 8000"
      ],
      "port": 8000
    },
    {
      "name": "web",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd frontend && npm run dev"
      ],
      "port": 5173
    }
  ]
}